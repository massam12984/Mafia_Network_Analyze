pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()

        buildDiscarder(
            logRotator(
                numToKeepStr: '5',
                artifactNumToKeepStr: '2'
            )
        )
    }

    environment {
        IMAGE_NAME = 'mafia-security-scan'
        REPORT_DIR = 'security-reports'

        TRIVY_IMAGE = 'aquasec/trivy:latest'
        TRIVY_CACHE_VOLUME = 'mafia-trivy-cache'
    }

    stages {

        stage('1. Checkout') {
            steps {
                echo 'Downloading project from GitHub...'

                checkout scm

                sh '''
                    set -eu

                    echo "Repository files:"
                    ls -la

                    echo ""
                    echo "Checking required files..."

                    test -f app.py
                    test -f requirements.txt
                    test -f Dockerfile
                    test -f sonar-project.properties
                    test -f Jenkinsfile.security

                    echo "All required files are available."
                '''
            }
        }

        stage('2. Validate Python') {
            steps {
                echo 'Validating Python syntax...'

                sh '''
                    set -eu

                    python3 --version
                    python3 -m py_compile app.py

                    echo "Python syntax validation passed."
                '''
            }
        }

        stage('3. Verify Docker and Trivy') {
            steps {
                echo 'Checking Docker and Trivy scanner...'

                sh '''
                    set -eu

                    echo "Docker version:"
                    docker --version

                    echo ""
                    echo "Checking Docker daemon:"
                    docker info >/dev/null

                    if ! docker image inspect "$TRIVY_IMAGE" \
                        >/dev/null 2>&1; then

                        echo "Trivy image is not available."
                        echo "Pulling Trivy image..."

                        docker pull "$TRIVY_IMAGE"
                    fi

                    echo ""
                    echo "Trivy version:"

                    docker run --rm \
                        "$TRIVY_IMAGE" \
                        --version

                    echo ""
                    echo "Docker and Trivy are ready."
                    echo "Grype will be installed by the Jenkins plugin."
                '''
            }
        }

        stage('4. SonarQube Analysis') {
            steps {
                echo 'Running SonarQube source-code analysis...'

                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh "${scannerHome}/bin/sonar-scanner"
                    }
                }
            }
        }

        stage('5. SonarQube Quality Gate') {
            steps {
                echo 'Waiting for SonarQube Quality Gate result...'

                /*
                 * SonarQube problem pipeline ko completely stop nahi karega.
                 * Stage unstable ho sakti hai, lekin Trivy aur Grype scans
                 * continue rahenge.
                 */

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'UNSTABLE'
                ) {
                    timeout(time: 10, unit: 'MINUTES') {
                        script {
                            def qualityGate = waitForQualityGate(
                                abortPipeline: false
                            )

                            echo "Quality Gate status: ${qualityGate.status}"

                            if (qualityGate.status != 'OK') {
                                unstable(
                                    "SonarQube Quality Gate status: " +
                                    qualityGate.status
                                )
                            }
                        }
                    }
                }
            }
        }

        stage('6. Build Docker Image') {
            steps {
                echo 'Building application Docker image...'

                sh '''
                    set -eu

                    docker build \
                        -t "$IMAGE_NAME:$BUILD_NUMBER" \
                        -t "$IMAGE_NAME:latest" \
                        .

                    docker image inspect \
                        "$IMAGE_NAME:$BUILD_NUMBER" \
                        >/dev/null

                    echo ""
                    echo "Docker image created successfully."
                    echo "Image: $IMAGE_NAME:$BUILD_NUMBER"

                    docker images "$IMAGE_NAME"
                '''
            }
        }

        stage('7. Trivy Vulnerability Scan') {
            steps {
                echo 'Scanning Docker image using Trivy...'

                timeout(time: 30, unit: 'MINUTES') {
                    sh '''
                        set -eu

                        rm -rf "$REPORT_DIR"
                        mkdir -p "$REPORT_DIR"

                        docker volume inspect \
                            "$TRIVY_CACHE_VOLUME" \
                            >/dev/null 2>&1 \
                            || docker volume create \
                                "$TRIVY_CACHE_VOLUME" \
                                >/dev/null

                        echo "Generating Trivy text report..."

                        docker run --rm \
                            --user 0:0 \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            -v "$TRIVY_CACHE_VOLUME:/root/.cache/" \
                            "$TRIVY_IMAGE" \
                            image \
                            --scanners vuln \
                            --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL \
                            --no-progress \
                            --format table \
                            "$IMAGE_NAME:$BUILD_NUMBER" \
                            > "$REPORT_DIR/trivy-report.txt"

                        echo "Generating Trivy JSON report..."

                        docker run --rm \
                            --user 0:0 \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            -v "$TRIVY_CACHE_VOLUME:/root/.cache/" \
                            "$TRIVY_IMAGE" \
                            image \
                            --scanners vuln \
                            --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL \
                            --no-progress \
                            --format json \
                            "$IMAGE_NAME:$BUILD_NUMBER" \
                            > "$REPORT_DIR/trivy-report.json"

                        test -s "$REPORT_DIR/trivy-report.txt"
                        test -s "$REPORT_DIR/trivy-report.json"

                        echo ""
                        echo "Trivy scan completed."
                        echo "Trivy report preview:"

                        head -n 50 \
                            "$REPORT_DIR/trivy-report.txt"
                    '''
                }
            }
        }

        stage('8. Grype Plugin Scan') {
            steps {
                echo 'Running GrypeScanner Jenkins plugin...'
                echo "Target image: docker:${IMAGE_NAME}:${BUILD_NUMBER}"

                timeout(time: 30, unit: 'MINUTES') {
                    grypeScan(
                        scanDest: "docker:${IMAGE_NAME}:${BUILD_NUMBER}",
                        repName: 'grype-report.txt',
                        autoInstall: true
                    )
                }

                echo 'GrypeScanner plugin scan completed.'
            }
        }

        stage('9. Publish Grype GUI Report') {
            steps {
                echo 'Publishing Grype findings in Jenkins GUI...'

                recordIssues(
                    id: 'grype-vulnerabilities',
                    name: 'Grype Vulnerability Report',
                    tools: [
                        grype()
                    ],
                    aggregatingResults: true,
                    enabledForFailure: true
                )

                echo 'Grype GUI report published successfully.'
            }
        }

        stage('10. Archive Trivy Reports') {
            steps {
                echo 'Saving Trivy reports as Jenkins artifacts...'

                archiveArtifacts(
                    artifacts: 'security-reports/*',
                    fingerprint: true,
                    allowEmptyArchive: false
                )

                echo 'Trivy reports archived.'
                echo 'GrypeScanner plugin saves its own scan report.'
            }
        }

        stage('11. Security Summary') {
            steps {
                sh '''
                    set -eu

                    echo "========================================"
                    echo "Docker Image"
                    echo "========================================"

                    docker images "$IMAGE_NAME"

                    echo ""
                    echo "========================================"
                    echo "Trivy Scanner"
                    echo "========================================"

                    docker images "$TRIVY_IMAGE"

                    echo ""
                    echo "========================================"
                    echo "Trivy Reports"
                    echo "========================================"

                    ls -lh "$REPORT_DIR"

                    echo ""
                    echo "========================================"
                    echo "Grype Plugin Configuration"
                    echo "========================================"

                    echo "Plugin: GrypeScanner"
                    echo "Target: docker:$IMAGE_NAME:$BUILD_NUMBER"
                    echo "Report name: grype-report.txt"
                    echo "Auto installation: Enabled"
                    echo "GUI publisher: Warnings plugin"

                    echo ""
                    echo "========================================"
                    echo "Final Result"
                    echo "========================================"

                    echo "Python validation completed."
                    echo "SonarQube analysis executed."
                    echo "Docker image built."
                    echo "Trivy scan completed."
                    echo "Grype plugin scan completed."
                    echo "Grype GUI report published."
                    echo "Security reports archived."
                '''
            }
        }
    }

    post {

        success {
            echo 'Security pipeline completed successfully.'
            echo 'Open this build to view the Grype GUI report.'
        }

        unstable {
            echo 'Pipeline completed with warnings.'
            echo 'Check SonarQube and Grype results.'
        }

        failure {
            echo 'Security pipeline failed.'
            echo 'Open Console Output and check the first failed stage.'
        }

        always {
            echo 'Cleaning Jenkins workspace...'
            cleanWs()
        }
    }
}
